# CAP-RUN-20261016 — إعدادات البوابة غير السرية. الأسرار تُولَّد في $RUN_BASE/secrets.env خارج git.
NODE_ENV=production
PORT=54300
DATABASE_URL=postgres://postgres@127.0.0.1:55432/ceezr_cap_20261016
SUPABASE_URL=https://supabase-unused.invalid
SUPABASE_SERVICE_ROLE_KEY=sandbox-fake-service-role
UPSTASH_REDIS_REST_URL=http://127.0.0.1:58081
BOOTSTRAP_ADMIN_TELEGRAM_ID=100000001
TELEGRAM_TRANSPORT=real
SESSION_STORE=redis
PROCESS_TOPOLOGY=single-process
RUN_WORKER_IN_GATEWAY=true
RUN_ADMIN_IN_GATEWAY=false
TRANSLATION_PROVIDER=none
ROUTING_PROVIDER=none
SERVICE_INSTANCE_ID=cap-gateway-1
TELEGRAM_DRAIN_LANES=32
MOCK_TELEGRAM_URL=http://127.0.0.1:58090
BOT_SURFACE_MODE=miniapp
MINIAPP_URL=https://miniapp.cap-test.local

# مفتاحُ بيئةِ اختبارِ السعةِ: مولّدٌ أحاديُّ العنوانِ يبادلُ آلافَ الجلساتِ في
# الدقيقةِ (كلِّ هويةٍ جلسةً) — الافتراضيُّ 30 لعتبةِ الإنتاجِ.
SESSION_EXCHANGE_PER_MINUTE=6000
# LOAD-01 Recovery (PR #563) — مسار إشارة العروض الداخلي ومزيج المولد
GATEWAY_INTERNAL_URL=http://127.0.0.1:54300
DRIVER_SOCKET_MIX=0.7
# ADR 0287 — مزيجُ اتصالِ الركّابِ بقناةِ أحداثِ الرحلةِ: مُعلَنٌ قبلَ الجولةِ ومسجَّلٌ
# في gen.start، وثابتٌ في كلِّ موجةِ قبولٍ (0.7 = نسبةُ السائقِ نفسُها). الجولاتُ
# التشخيصيةُ وحدَها تُغيّرُه صراحةً لعزلِ الأثرِ.
RIDER_SOCKET_MIX=${RIDER_SOCKET_MIX:-0.7}
