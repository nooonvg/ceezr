{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "!node_modules",
      "!coverage",
      "!docs/evidence",
      "!docs/contracts",
      "!**/dist",
      "!deploy/sandbox-soak/logs",
      "!deploy/sandbox-soak/reports"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "off"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error"
      },
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "tests/unit/check-jsonb-binding.test.ts",
        "tests/unit/check-css-class-coverage.test.ts",
        "tests/unit/check-driver-documents-contract.test.ts",
        "tests/unit/check-integration-city-precondition.test.ts",
        "tests/unit/check-lazy-query-assertion.test.ts",
        "tests/unit/check-sos-surface-contract.test.ts",
        "tests/unit/check-wall-clock-window-tests.test.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
