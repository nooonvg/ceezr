+if [ "$lvl" != t ]; then echo "TEMPLATE_LEVEL_MISMATCH $R"; exit 9; fi
+echo "=== $(date -Is) START $R conc=$CONC side=$SIDE (diag+trace+conn)"
+( printf "%s\n" "set application_name='b23-conn-sampler';" "select (extract(epoch from clock_timestamp())*1000)::bigint as t, coalesce(application_name,''), coalesce(state,''), count(*) from pg_stat_activity where datname='ceezr_cap_20261016' and backend_type='client backend' group by 2,3 \\watch 2" | $PSQL -d postgres -At -F, > $B/conn-cur.txt 2>/dev/null ) &
+SP=$!
