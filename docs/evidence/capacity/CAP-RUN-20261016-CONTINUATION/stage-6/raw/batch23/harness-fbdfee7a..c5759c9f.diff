diff --git a/deploy/capacity-run/b23-runner/seat-bin/sched-sampler.py b/deploy/capacity-run/b23-runner/seat-bin/sched-sampler.py
new file mode 100755
index 00000000..87be86d6
--- /dev/null
+++ b/deploy/capacity-run/b23-runner/seat-bin/sched-sampler.py
@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""الدفعة 23 — عيّناتُ جدولةِ المعالج كلَّ ثانية (تشخيصٌ فقط؛ لا يدخلُ الصلاحيةَ ولا البوابات).
+
+sched-sampler.py <out.jsonl> <seconds>
+لكلِّ ثانية: ضغطُ CPU من /proc/pressure/cpu (some: نسبةُ الزمنِ الذي انتظرَت فيه مهمّةٌ واحدةٌ على الأقلّ
+المعالجَ)، وprocs_running، ولكلِّ صنفٍ (gateway · postgres · generator · other_seat) فرقُ زمنِ التشغيلِ
+وفرقُ زمنِ الانتظارِ في طابورِ التشغيل من /proc/<pid>/task/*/schedstat (الحقلانِ 1 و2 بالنانوثانية).
+"""
+import json, os, sys, time
+
+OUT, SECS = sys.argv[1], int(sys.argv[2])
+
+
+def rd(p):
+    try:
+        with open(p) as f:
+            return f.read()
+    except OSError:
+        return None
+
+
+def classify(cmd):
+    if cmd.startswith("postgres") or "bin/postgres" in cmd: return "postgres"
+    if "apps/gateway" in cmd: return "gateway"
+    if "miniapp-load" in cmd or "capacity-run/load" in cmd: return "generator"
+    if any(p in cmd for p in ("redis-server", "shim.ts", "telegram-mock")): return "other_seat"
+    return None
+
+
+def psi():
+    t = rd("/proc/pressure/cpu") or ""
+    for line in t.splitlines():
+        if line.startswith("some"):
+            return int(line.split("total=")[1])
+    return None
+
+
+def snap():
+    acc = {}
+    for pid in os.listdir("/proc"):
+        if not pid.isdigit(): continue
+        c = rd(f"/proc/{pid}/cmdline")
+        if not c: continue
+        k = classify(c.replace("\0", " ").strip())
+        if k is None: continue
+        try:
+            tids = os.listdir(f"/proc/{pid}/task")
+        except OSError:
+            continue
+        for tid in tids:
+            s = rd(f"/proc/{pid}/task/{tid}/schedstat")
+            if not s: continue
+            run, wait = (int(x) for x in s.split()[:2])
+            a = acc.setdefault(k, {})
+            a[f"{pid}/{tid}"] = (run, wait)
+    return acc
+
+
+def running():
+    for line in (rd("/proc/stat") or "").splitlines():
+        if line.startswith("procs_running"):
+            return int(line.split()[1])
+    return None
+
+
+with open(OUT, "a") as fo:
+    fo.write(json.dumps({"k": "meta", "t": round(time.time() * 1000), "ncpu": os.cpu_count()}) + "\n")
+    prev, prev_psi, prev_t = snap(), psi(), time.time()
+    end = prev_t + SECS
+    while time.time() < end:
+        time.sleep(1)
+        cur, cur_psi, t = snap(), psi(), time.time()
+        dt = t - prev_t
+        row = {"k": "sched", "t": round(t * 1000), "procs_running": running(),
+               "psi_some_pct": round((cur_psi - prev_psi) / (dt * 1e4), 2) if cur_psi is not None and prev_psi is not None else None}
+        for k, threads in cur.items():
+            dr = dw = 0
+            for key, (r, w) in threads.items():
+                pr, pw = prev.get(k, {}).get(key, (0, 0))
+                dr += max(0, r - pr); dw += max(0, w - pw)
+            # بوحدةِ «نواةٍ واحدة %»: 100 = نواةٌ كاملةٌ طوالَ الثانية.
+            row[k] = {"run_pct_1core": round(dr / (dt * 1e7), 1), "runq_wait_pct_1core": round(dw / (dt * 1e7), 1),
+                      "threads": len(threads)}
+        fo.write(json.dumps(row) + "\n"); fo.flush()
+        prev, prev_psi, prev_t = cur, cur_psi, t
diff --git a/deploy/capacity-run/b23-runner/seat-bin/speed-probe.py b/deploy/capacity-run/b23-runner/seat-bin/speed-probe.py
new file mode 100755
index 00000000..f59d2be7
--- /dev/null
+++ b/deploy/capacity-run/b23-runner/seat-bin/speed-probe.py
@@ -0,0 +1,24 @@
+#!/usr/bin/env python3
+"""مِسبارُ سرعةٍ ثابتُ العمل (الدفعةُ الثانيةَ عشرة): sha256 لـ 512MiB على كلِّ نواةٍ بالتوازي (عمليّتان).
+
+يطبعُ JSON: زمنُ الجدارِ وزمنُ CPU لكلِّ عامل. العملُ ثابتٌ حرفيًّا، فاختلافُ الزمنِ اختلافُ المضيف
+(سرعةُ النواة، السرقة، التنافس) لا الشيفرة. يُستعملُ للمرجعِ في الخمولِ وللفحصِ المسبقِ قبلَ كلِّ موجة.
+"""
+import hashlib, json, multiprocessing as mp, os, sys, time
+
+BUF = b"\x5a" * (1 << 20)
+
+
+def work(_):
+    c0 = time.process_time(); t0 = time.perf_counter(); h = hashlib.sha256()
+    for _ in range(512):
+        h.update(BUF)
+    return {"wall_ms": round((time.perf_counter() - t0) * 1000, 1), "cpu_ms": round((time.process_time() - c0) * 1000, 1)}
+
+
+if __name__ == "__main__":
+    n = int(sys.argv[1]) if len(sys.argv) > 1 else 2
+    with mp.Pool(n) as p:
+        work(0)
+        t0 = time.perf_counter(); r = p.map(work, range(n)); t = (time.perf_counter() - t0) * 1000
+    print(json.dumps({"t": round(time.time() * 1000), "workers": r, "max_wall_ms": max(x["wall_ms"] for x in r), "total_ms": round(t, 1)}))
