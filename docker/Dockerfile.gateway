# الغرض: صورة البوابة — تشغيل apps/gateway/src/index.ts وحده.
# ملاحظات:
#   • الوسم مثبَّت على إصدار دقيق لا `oven/bun:1` العائم: صورةٌ عائمة تعني أنّ
#     البناء الذي فحصه CI اليوم ليس البناء الذي سيُنشَر غداً.
#   • `bun.lock` منسوخ و`--frozen-lockfile` مفروض: بلا القفل تُحلّ الاعتماديات
#     من جديد داخل الصورة بمعزل عمّا فحصه CI، فيصير الأخضر شهادةً على شيءٍ آخر.
#   • `apps` كلّها منسوخة لا `apps/gateway` وحدها: البوابة تستورد فعلاً
#     `apps/workers/src/container.ts` (العامل المضمَّن) و`apps/admin-dashboard/src`
#     (عرض لوحة الإدارة). نسخُ المجلَّد وحده كان يُنتج صورةً لا تُقلع إطلاقاً.
#   • خطوة `bun build` أدناه ليست بناءً للنشر بل حارس: هي تحلّ كلّ استيراد
#     ساكناً، فيفشل `docker build` صراحةً عند نقص وحدة بدل أن يفشل الإقلاع
#     في الإنتاج. وهذه بالضبط الطريقة التي كان يُكتشَف بها نقص `apps/workers`.
#   • بيانُ كلِّ مساحةِ عملٍ في الجذر (`apps/*/package.json`) منسوخٌ قبل التثبيت:
#     القفلُ الواحد يشمل مساحاتِ العمل كلَّها منذ انضمام تطبيق تِلِغرام المصغَّر،
#     و`--frozen-lockfile` يرفض التثبيتَ إذا غاب بيانُ إحداها — فلا يكفي نسخُ
#     بيانِ الجذر وحده. والحارس في scripts/verify-container-build.sh يُلزم بهذا.
FROM oven/bun:1.4.2 AS base
WORKDIR /app

COPY package.json bun.lock tsconfig.json ./
COPY patches ./patches
COPY apps/miniapp/package.json ./apps/miniapp/package.json
RUN bun install --frozen-lockfile

COPY packages ./packages
COPY apps ./apps

RUN bun build apps/gateway/src/index.ts --target=bun --outfile=/tmp/gateway-resolve-check.js \
  && rm -f /tmp/gateway-resolve-check.js

ENV NODE_ENV=production
EXPOSE 3000
CMD ["bun", "run", "apps/gateway/src/index.ts"]
